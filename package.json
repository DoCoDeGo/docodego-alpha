{
  "name": "docodego",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc -p apps/cli/tsconfig.json --noEmit && tsc -p apps/spec/tsconfig.json --noEmit",
    "test": "npm run conformance && npm run fuzz",
    "conformance": "npm --prefix apps/cli run -s conformance",
    "fuzz": "npm --prefix apps/cli run -s fuzz",
    "bundle": "npm --prefix apps/cli run -s bundle",
    "bundle:verify": "npm --prefix apps/cli run -s bundle:verify",
    "docs": "npm --prefix apps/cli run -s docs",
    "docs:verify": "npm --prefix apps/cli run -s docs:verify",
    "build": "npm --prefix apps/cli run -s build"
  }
}
