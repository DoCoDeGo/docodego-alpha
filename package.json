{
  "name": "docodego",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "docodego": "workspace:*",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "docodego": "node apps/cli/src/main.ts",
    "canon": "node --experimental-strip-types apps/canon/src/main.ts",
    "check": "node apps/cli/src/main.ts check",
    "status": "node apps/cli/src/main.ts status",
    "doctor": "node apps/cli/src/main.ts doctor",
    "typecheck": "tsc -p apps/cli/tsconfig.json --noEmit && tsc -p apps/canon/tsconfig.json --noEmit",
    "test": "pnpm run conformance && pnpm run fuzz",
    "conformance": "pnpm -C apps/cli run -s conformance",
    "fuzz": "pnpm -C apps/cli run -s fuzz",
    "bundle": "pnpm -C apps/cli run -s bundle",
    "bundle:verify": "pnpm -C apps/cli run -s bundle:verify",
    "docs": "pnpm -C apps/cli run -s docs",
    "docs:verify": "pnpm -C apps/cli run -s docs:verify",
    "build": "pnpm -C apps/cli run -s build"
  }
}
